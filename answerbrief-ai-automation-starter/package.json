    "supervisor": "node ./scripts/career-os-autonomous-supervisor.mjs",
    "supervisor:no-repair": "CAREER_OS_AUTO_REPAIR=0 node ./scripts/career-os-autonomous-supervisor.mjs",
    "mcp": "node ./scripts/career-os-mcp-server.mjs",
    "openhands:status": "node ./scripts/manage-openhands-service.mjs status",
    "openhands:start": "node ./scripts/manage-openhands-service.mjs start",
    "openhands:stop": "node ./scripts/manage-openhands-service.mjs stop",
    "openhands:restart": "node ./scripts/manage-openhands-service.mjs restart",
    "health:career-os": "node ./scripts/career-os-production-health.mjs",
    "worker:pair": "node ./scripts/career-os-browser-companion.mjs pair",
    "worker:start": "node ./scripts/career-os-browser-companion.mjs start",
    "worker:run-once": "node ./scripts/career-os-browser-companion.mjs run-once",
    "worker:health": "node ./scripts/career-os-browser-companion.mjs health",
    "browser:controlled": "node ./scripts/career-os-controlled-browser.mjs",
    "report:career-os": "node ./scripts/career-os-production-report.mjs",
    "outcomes:ingest": "node ./scripts/career-os-ingest-outcomes.mjs",
    "workday:canary": "node ./scripts/career-os-workday-canary.mjs",
    "workday:observe": "node ./scripts/career-os-workday-observe.mjs",
    "linkedin:discover": "node ./scripts/career-os-linkedin-discovery.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "@stripe/stripe-js": "^4.0.0",
    "express": "^5.1.0",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "playwright": "^1.54.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.17.2",
    "stripe": "^16.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^18.3.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
